{
	"name": "lexi-vocabulary",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types tests/run.ts",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{js,ts,json}\"",
		"lint": "npm run lint:code && npm run lint:styles",
		"lint:code": "eslint src tests *.config.js vite.config.ts --max-warnings=0",
		"lint:styles": "stylelint \"src/**/*.css\" --max-warnings=0",
		"lint:fix": "npm run lint:code -- --fix && npm run lint:styles -- --fix",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{js,ts,json}\"",
		"check": "npm run lint && npm run format:check && npm test && npm run build"
	},
	"dependencies": {
		"lucide-react": "0.487.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "22.15.30",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "4.5.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^16.5.0",
		"prettier": "^3.5.3",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "6.3.5"
	},
	"engines": {
		"node": "^22.13.0 || >=24.0.0"
	}
}
