{
  "name": "lexi-vocabulary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\""
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
